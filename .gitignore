# --- Unity 하위 폴더 대응용 수정 버전 ---

# 하위 폴더 내의 임시 폴더들 제외
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.utmp/
*.log

# Memory 및 Recording 제외
[Mm]emoryCaptures/
[Rr]ecordings/

# 에셋 스토어 툴 제외
[Aa]ssets/AssetStoreTools*

# 비주얼 스튜디오 및 라이더 관련 설정 파일
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# 빌드 결과물 (용량 방지)
*.apk
*.aab
*.unitypackage
*.app

# OS 생성 파일
.DS_Store
Thumbs.db

# Unity 자동 생성 메타 파일 중 일부 제외
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*

# 가시화 및 스크립팅 관련
[Aa]ssets/Unity.VisualScripting.Generated/
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
